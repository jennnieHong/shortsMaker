#include <napi.h>
#include <iostream>
#include <string>
#include <vector>

extern "C" {
#include <libavformat/avformat.h>
#include <libavcodec/avcodec.h>
#include <libswscale/swscale.h>
#include <libavutil/imgutils.h>
}

struct ClipInfo {
    std::string path;
    double trimStart;
    double trimEnd;
};

// 비동기 렌더링 작업을 수행할 워커 클래스 (Napi::AsyncWorker 상속)
class VideoRenderWorker : public Napi::AsyncWorker {
public:
    VideoRenderWorker(Napi::Env& env, std::vector<ClipInfo> clips, std::string outPath, Napi::Promise::Deferred deferred)
        : Napi::AsyncWorker(env), clips(clips), outputPath(outPath), deferred(deferred) {}

    ~VideoRenderWorker() {}

    // 이 함수는 별도의 C++ 백그라운드 스레드에서 실행됩니다. (UI 프리징 방지)
    void Execute() override {
        std::cout << "======================================" << std::endl;
        std::cout << "[C++ 엔진] 멀티 클립 인코딩 시작! (클립 수: " << clips.size() << ")" << std::endl;
        
        // 출력 컨텍스트 생성
        AVFormatContext* ofmt_ctx = nullptr;
        if (avformat_alloc_output_context2(&ofmt_ctx, nullptr, nullptr, outputPath.c_str()) < 0 || !ofmt_ctx) {
            SetError("출력 컨텍스트를 생성할 수 없습니다. 확장자를 확인하세요."); return;
        }
        
        // H.264 코덱 시도, 없으면 기본 mpeg4 사용
        const AVCodec* enc = avcodec_find_encoder_by_name("libx264");
        if (!enc) enc = avcodec_find_encoder(AV_CODEC_ID_MPEG4);
        if (!enc) {
            SetError("인코더를 찾을 수 없습니다."); return;
        }
        
        AVStream* out_stream = avformat_new_stream(ofmt_ctx, enc);
        AVCodecContext* enc_ctx = avcodec_alloc_context3(enc);
        
        // 쇼츠 규격 (9:16)
        enc_ctx->width = 720;
        enc_ctx->height = 1280;
        enc_ctx->pix_fmt = AV_PIX_FMT_YUV420P;
        enc_ctx->time_base = {1, 30}; // 30 FPS
        out_stream->time_base = enc_ctx->time_base;
        if (avcodec_open2(enc_ctx, enc, nullptr) < 0) {
            SetError("인코더를 열 수 없습니다."); return;
        }
        avcodec_parameters_from_context(out_stream->codecpar, enc_ctx);

        if (!(ofmt_ctx->oformat->flags & AVFMT_NOFILE)) {
            if (avio_open(&ofmt_ctx->pb, outputPath.c_str(), AVIO_FLAG_WRITE) < 0) {
                SetError("출력 파일을 생성할 수 없습니다. 권한 문제일 수 있습니다."); return;
            }
        }
        
        if (avformat_write_header(ofmt_ctx, nullptr) < 0) {
            SetError("출력 파일 헤더를 쓸 수 없습니다."); return;
        }

        // 전체 출력 프레임 생성
        AVFrame* out_frame = av_frame_alloc();
        out_frame->format = AV_PIX_FMT_YUV420P;
        out_frame->width = 720;
        out_frame->height = 1280;
        if (av_frame_get_buffer(out_frame, 32) < 0) {
            SetError("출력 프레임 버퍼를 할당할 수 없습니다."); return;
        }

        int global_pts = 0;

        // 전달받은 모든 영상을 순회하며 이어 붙입니다.
        for (const ClipInfo& clip : clips) {
            std::cout << "-> 파일 처리 중: " << clip.path << " (" << clip.trimStart << "s ~ " << clip.trimEnd << "s)" << std::endl;
            
            AVFormatContext* ifmt_ctx = nullptr;
            if (avformat_open_input(&ifmt_ctx, clip.path.c_str(), nullptr, nullptr) < 0) {
                std::cerr << "경고: 파일을 열 수 없습니다: " << clip.path << std::endl;
                continue; // 에러가 나도 다음 영상으로 넘어갑니다.
            }
            avformat_find_stream_info(ifmt_ctx, nullptr);
            
            int video_stream_idx = -1;
            for (unsigned int i = 0; i < ifmt_ctx->nb_streams; i++) {
                if (ifmt_ctx->streams[i]->codecpar->codec_type == AVMEDIA_TYPE_VIDEO) {
                    video_stream_idx = i; break;
                }
            }
            if (video_stream_idx == -1) {
                avformat_close_input(&ifmt_ctx);
                continue;
            }

            AVStream* in_stream = ifmt_ctx->streams[video_stream_idx];
            const AVCodec* dec = avcodec_find_decoder(in_stream->codecpar->codec_id);
            AVCodecContext* dec_ctx = avcodec_alloc_context3(dec);
            avcodec_parameters_to_context(dec_ctx, in_stream->codecpar);
            if (avcodec_open2(dec_ctx, dec, nullptr) < 0) {
                avcodec_free_context(&dec_ctx);
                avformat_close_input(&ifmt_ctx);
                continue;
            }

            // 정중앙 크롭 계산 (홀수 픽셀 에러 방지를 위해 짝수로 맞춤)
            int in_w = dec_ctx->width;
            int in_h = dec_ctx->height;
            int target_w = (in_h * 9 / 16) & ~1; 
            int target_h = in_h & ~1;
            int crop_x = ((in_w - target_w) / 2) & ~1;
            int crop_y = 0;

            // 크기 변환용 SwsContext
            SwsContext* sws_ctx = sws_getContext(target_w, target_h, dec_ctx->pix_fmt,
                                                 720, 1280, AV_PIX_FMT_YUV420P,
                                                 SWS_BILINEAR, nullptr, nullptr, nullptr);
            if (!sws_ctx) {
                avcodec_free_context(&dec_ctx);
                avformat_close_input(&ifmt_ctx);
                continue;
            }

            AVPacket* pkt = av_packet_alloc();
            AVFrame* frame = av_frame_alloc();
            
            // 지정된 시작 시간으로 점프 (탐색 속도 향상)
            int64_t start_pts = (int64_t)(clip.trimStart * AV_TIME_BASE);
            av_seek_frame(ifmt_ctx, -1, start_pts, AVSEEK_FLAG_BACKWARD);

            bool done = false;
            while (av_read_frame(ifmt_ctx, pkt) >= 0 && !done) {
                if (pkt->stream_index == video_stream_idx) {
                    if (avcodec_send_packet(dec_ctx, pkt) >= 0) {
                        while (avcodec_receive_frame(dec_ctx, frame) == 0) {
                            
                            // 현재 프레임의 시간을 초(sec)로 계산
                            double current_time_sec = frame->best_effort_timestamp * av_q2d(in_stream->time_base);
                            
                            if (current_time_sec < clip.trimStart) {
                                continue; // 목표 시작 시간 도달 전이면 스킵
                            }
                            if (current_time_sec > clip.trimEnd) {
                                done = true; // 종료 시간이면 디코딩 중단
                                break;
                            }
                            // 데이터 포인터를 밀어서 크롭 효과 적용
                            uint8_t* src_data[4];
                            int src_linesize[4];
                            for(int i=0; i<4; i++) {
                                src_data[i] = frame->data[i];
                                src_linesize[i] = frame->linesize[i];
                            }
                            if (src_data[0] != nullptr) {
                                src_data[0] += crop_y * src_linesize[0] + crop_x;
                                src_data[1] += (crop_y/2) * src_linesize[1] + (crop_x/2);
                                src_data[2] += (crop_y/2) * src_linesize[2] + (crop_x/2);
                                
                                sws_scale(sws_ctx, src_data, src_linesize, 0, target_h, out_frame->data, out_frame->linesize);

                                // 가장 중요한 포인트: 영상이 바뀌어도 pts(타임스탬프)는 계속 증가해야 함
                                out_frame->pts = global_pts++;
                                
                                if (avcodec_send_frame(enc_ctx, out_frame) >= 0) {
                                    AVPacket* out_pkt = av_packet_alloc();
                                    while (avcodec_receive_packet(enc_ctx, out_pkt) == 0) {
                                        out_pkt->stream_index = out_stream->index;
                                        av_packet_rescale_ts(out_pkt, enc_ctx->time_base, out_stream->time_base);
                                        av_interleaved_write_frame(ofmt_ctx, out_pkt);
                                        av_packet_unref(out_pkt);
                                    }
                                    av_packet_free(&out_pkt);
                                }
                            }
                        }
                    }
                }
                av_packet_unref(pkt);
            }

            av_packet_free(&pkt);
            av_frame_free(&frame);
            sws_freeContext(sws_ctx);
            avcodec_free_context(&dec_ctx);
            avformat_close_input(&ifmt_ctx);
        }

        // 모든 영상 처리 후 스트림 마무리 (Flush)
        avcodec_send_frame(enc_ctx, nullptr);
        AVPacket* out_pkt = av_packet_alloc();
        while (avcodec_receive_packet(enc_ctx, out_pkt) == 0) {
            out_pkt->stream_index = out_stream->index;
            av_packet_rescale_ts(out_pkt, enc_ctx->time_base, out_stream->time_base);
            av_interleaved_write_frame(ofmt_ctx, out_pkt);
            av_packet_unref(out_pkt);
        }
        av_packet_free(&out_pkt);

        av_write_trailer(ofmt_ctx);
        if (!(ofmt_ctx->oformat->flags & AVFMT_NOFILE)) {
            avio_closep(&ofmt_ctx->pb);
        }
        avformat_free_context(ofmt_ctx);
        avcodec_free_context(&enc_ctx);
        av_frame_free(&out_frame);

        resultMessage = "✅ 멀티 클립 렌더링 완료! 저장됨: " + outputPath;
        std::cout << "[C++ 엔진] 저장 완료!" << std::endl;
        std::cout << "======================================" << std::endl;
    }

    void OnOK() override {
        Napi::HandleScope scope(Env());
        deferred.Resolve(Napi::String::New(Env(), resultMessage));
    }

    void OnError(const Napi::Error& e) override {
        Napi::HandleScope scope(Env());
        deferred.Reject(Napi::String::New(Env(), e.Message()));
    }

private:
    std::vector<ClipInfo> clips;
    std::string outputPath;
    Napi::Promise::Deferred deferred;
    std::string resultMessage;
};

// JS에서 호출될 렌더링 진입점 함수
Napi::Value RenderVideo(const Napi::CallbackInfo& info) {
    Napi::Env env = info.Env();

    if (info.Length() < 2 || !info[0].IsArray() || !info[1].IsString()) {
        Napi::TypeError::New(env, "첫 번째 인자는 배열, 두 번째 인자는 문자열이어야 합니다.").ThrowAsJavaScriptException();
        return env.Null();
    }

    Napi::Array clipsArray = info[0].As<Napi::Array>();
    std::vector<ClipInfo> clips;
    for (uint32_t i = 0; i < clipsArray.Length(); i++) {
        Napi::Object clipObj = clipsArray.Get(i).As<Napi::Object>();
        std::string path = clipObj.Get("path").As<Napi::String>().Utf8Value();
        double trimStart = clipObj.Has("trimStart") ? clipObj.Get("trimStart").As<Napi::Number>().DoubleValue() : 0.0;
        double trimEnd = clipObj.Has("trimEnd") ? clipObj.Get("trimEnd").As<Napi::Number>().DoubleValue() : 5.0;
        clips.push_back({ path, trimStart, trimEnd });
    }

    std::string outputPath = info[1].As<Napi::String>().Utf8Value();

    // JS 비동기 Promise 생성
    Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
    
    // 백그라운드 워커 생성 및 큐에 등록 (비동기 실행 시작)
    VideoRenderWorker* worker = new VideoRenderWorker(env, clips, outputPath, deferred);
    worker->Queue();
    
    // JS 쪽에 당장 기다리라(Promise)고 객체를 반환해 줌 (블로킹 방지)
    return deferred.Promise();
}

Napi::Object Init(Napi::Env env, Napi::Object exports) {
    exports.Set(Napi::String::New(env, "renderVideo"), Napi::Function::New(env, RenderVideo));
    return exports;
}

NODE_API_MODULE(video_engine, Init)
